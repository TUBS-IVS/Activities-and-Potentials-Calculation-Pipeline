# ── Secrets ───────────────────────────────────────────────────────────────────
.env

# ── Large input / output data (region-specific, not for version control) ──────
data/input/*
!data/input/.gitkeep

data/output/*
!data/output/.gitkeep

# Throwaway layers made to be looked at in QGIS and then rewritten. Written by
# notebooks 01 and 04 and the scripts/08_qgis_* scripts, hundreds of MB, never
# an input to anything.
data/experimental_extract/*
!data/experimental_extract/.gitkeep

# Reference tables: the two tables step 04 reads are tracked, anything else placed
# here is not.
data/reference/*
!data/reference/.gitkeep
!data/reference/building_function_codelist_de_en.csv
!data/reference/alkis_building_activity_map.csv

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Working notes ─────────────────────────────────────────────────────────────
# Notes and hand-offs, kept local and moved between machines by hand.
docs/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
